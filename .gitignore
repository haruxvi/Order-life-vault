# Estado local de Obsidian
.obsidian/workspace*.json
.trash/

# Herramientas externas (no son parte del vault)
.anchor/

# Datos generados por Raíz en cada equipo
.obsidian/plugins/raiz/vectores.json
.obsidian/plugins/*/data.json.backup*

# Plugins sin licencia declarada: no se redistribuyen (ver TERCEROS.md)
.obsidian/plugins/oz-image-plugin/
.obsidian/plugins/url-into-selection/

# Portadas descargadas de servicios externos (pertenecen a sus titulares)
11 Biblioteca/_portadas/

# Tus portadas (imágenes de terceros): se quedan en tu PC
06 Plantillas/Portadas/*
!06 Plantillas/Portadas/.gitkeep

# Fuentes que agregas desde tu PC (pueden tener licencia propia)
.obsidian/plugins/raiz/fuentes/

# Wiki: las fuentes en crudo son de terceros y los datos se generan solos
13 Wiki/Fuentes/*
!13 Wiki/Fuentes/.gitkeep
13 Wiki/Datos/

# Datos locales de Raíz: consumo de IA y la caché de la herramienta para agentes
.obsidian/plugins/raiz/consumo.jsonl
.obsidian/plugins/raiz/.boveda-cache.json
.obsidian/plugins/raiz/.boveda-medicion.jsonl
.obsidian/plugins/raiz/.boveda-respaldos/
